{
  "name": "dustii-downloads-gateway",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-04",
  // Safe until a complete READY release and its exposure policy are accepted.
  "vars": { "DELIVERY_ENABLED": "false" },
  "r2_buckets": [
    { "binding": "DUSTII_DOWNLOADS", "bucket_name": "dustii-downloads" }
  ],
  "env": {
    "preview": {
      "vars": { "DELIVERY_ENABLED": "false" },
      "r2_buckets": []
    }
  }
}
